# Copy this file to .env and change the values. .env is gitignored; never commit it.
# Placeholders only: nothing in this file is a real secret.

# --- PostgreSQL (the postgres container reads these on first start) ---
POSTGRES_USER=cornerman
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cornerman
# How code running on your PC reaches that database.
DATABASE_URL=postgresql://cornerman:change-me-local-only@localhost:5432/cornerman

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AWS (fake AWS via moto locally from Step 4; real AWS in prod) ---
AWS_REGION=us-west-2
# Local only. Leave this unset in production so boto3 talks to real AWS.
AWS_ENDPOINT_URL=http://moto:5000
RAW_BUCKET=cornerman-raw-local
QUEUE_URL=
DLQ_URL=

# --- API ---
# Shared secret the gateway sends in the X-Device-Token header.
DEVICE_TOKEN=change-me

# --- Observability (Step 11) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cornerman

# --- Production only (Step 10) ---
DOMAIN=
DUCKDNS_TOKEN=

# --- Gateway only (Step 2b; containers ignore these) ---
GATEWAY_API_URL=http://localhost:8000
BLE_DEVICE_NAME=WristIMU
